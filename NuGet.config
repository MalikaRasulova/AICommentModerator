<?xml version="1.0" encoding="utf-8"?>
<!--
  Only nuget.org, so a machine-wide private feed that happens to be unreachable
  cannot stall or break the restore for this repository.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
